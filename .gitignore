# =====================================================================
# 🚀 Sales 24 Pro - Git Ignore Configuration (النسخة المحلية المطورة والنهائية)
# =====================================================================

# 📦 Dependencies (الحزم والتبعيات)
node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# 🔑 Environment & Secrets (الملفات السرية والمتغيرات)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets/
credentials/

# 📝 Logs & Debugging (السجلات وأخطاء التشغيل)
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pm2.log*

# 📁 User Uploads & Temp Files (ملفات الميديا والمرفوعات والمجلدات المؤقتة)
uploads/*
!uploads/.gitkeep
public/uploads/*
!public/uploads/.gitkeep
storage/uploads/*
!storage/uploads/.gitkeep
temp/
tmp/
*.tmp
*.temp
downloads/

# 💻 OS & System Files (ملفات النظام والتشغيل)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# 🛠️ IDE & Editors (ملفات بيئات التطوير والمحررات)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.user
*.code-workspace

# 🧪 Testing & Coverage (تقارير الاختبارات)
coverage/
.nyc_output/
.jest/
cypress/videos/
cypress/screenshots/

# 🏗️ Production Build Output & Caching (ملفات البناء والتجميع والذاكرة المؤقتة)
dist/
build/
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo
.eslintcache
.stylelintcache

# 🌐 Deployment & Serverless Platforms (منصات النشر السحابي والحاويات)
.vercel/
.netlify/
.serverless/
.railway/
.render/
Dockerfile.local
docker-compose.override.yml

# 📊 Database & Local Storage Backups (النسخ الاحتياطية المحلية وملفات JSON)
*.sqlite
*.sqlite3
data/*.db
# استثناء ملفات النسخ الاحتياطي الخاصة بالمتصفح ليسمح برفعها أو تتبعها إذا رغبت
!sales24-backup-*.json
