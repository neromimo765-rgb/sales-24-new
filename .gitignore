# =====================================================================
# 🚀 Sales 24 Pro - Git Ignore Configuration
# =====================================================================

# 📦 Dependencies (الحزم والتبعيات)
node_modules/
jspm_packages/
web_modules/

# 🔑 Environment & Secrets (الملفات السرية والمتغيرات)
.env
.env.local
.env.development
.env.test
.env.production
*.pem
*.key

# 📝 Logs & Debugging (السجلات وأخطاء التشغيل)
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# 📁 User Uploads & Temp Files (ملفات الميديا والمرفوعات)
uploads/*
!uploads/.gitkeep
public/uploads/*
!public/uploads/.gitkeep
temp/
tmp/

# 💻 OS & System Files (ملفات النظام والتشغيل)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 🛠️ IDE & Editors (ملفات بيئات التطوير)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 🧪 Testing & Coverage (تقارير الاختبارات)
coverage/
.nyc_output/

# 🏗️ Production Build Output (ملفات البناء والتجميع)
dist/
build/
